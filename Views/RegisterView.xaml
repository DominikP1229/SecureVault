<UserControl x:Class="SecureVault.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SecureVault.Views"
             mc:Ignorable="d" >
    
    <Grid>
        <Border Background="#2D2D30"
        Padding="30"
        CornerRadius="10"
        Width="300"
        VerticalAlignment="Center"
        HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Register" FontSize="22"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"/>
                <TextBlock Text="Login" Foreground="White"/>
                <TextBox x:Name="LoginBox"/>
                <TextBlock Text="Password"
           Foreground="White"/>

                <PasswordBox x:Name="PasswordBox"
             Margin="0,5,0,15"/>
                <Button Content="Register" Height="25" Click="Register_Click" />
                <Button Content="Cancel" Height="25" Click="Cancel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
