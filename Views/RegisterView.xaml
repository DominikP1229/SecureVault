<UserControl x:Class="SecureVault.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SecureVault.ViewModel"
             Background="{StaticResource AppBackgroundBrush}"
             KeyDown="RegisterView_KeyDown">
    <Grid>
        <Border Style="{StaticResource PanelCard}"
                Width="390"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Create account"
                           Style="{StaticResource PageTitleText}"/>

                <TextBlock Text="Login" Style="{StaticResource FieldLabelText}"/>
                <TextBox x:Name="LoginBox"
                         Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Password" Style="{StaticResource FieldLabelText}"/>
                <PasswordBox x:Name="PasswordBox"
                             vm:PasswordBoxBinding.BindPassword="True"
                             vm:PasswordBoxBinding.BoundPassword="{Binding Password, Mode=TwoWay}"
                             KeyDown="PasswordBox_KeyDown"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,24,0,0">
                    <Button Content="Cancel"
                            Width="96"
                            Command="{Binding CancelCommand}"/>
                    <Button Content="Register"
                            Width="104"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding RegisterCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
