<UserControl x:Class="SecureVault.Views.AddPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}"
             KeyDown="AddPasswordView_KeyDown">
    <Grid Margin="28">
        <Border Style="{StaticResource PanelCard}"
                MaxWidth="680"
                HorizontalAlignment="Center">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Password entry"
                               Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="Store login details, website and notes for this credential."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Title" Style="{StaticResource FieldLabelText}"/>
                            <TextBox Text="{Binding Title}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Username" Style="{StaticResource FieldLabelText}"/>
                            <TextBox Text="{Binding Username}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Category" Style="{StaticResource FieldLabelText}"/>
                    <ComboBox ItemsSource="{Binding Categories}"
                              DisplayMemberPath="CategoryType"
                              SelectedValuePath="CategoryType"
                              SelectedValue="{Binding Category}"/>

                    <TextBlock Text="Password" Style="{StaticResource FieldLabelText}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,10,0"/>
                        <Button Grid.Column="1"
                                Content="Generate"
                                Width="104"
                                Command="{Binding GeneratePasswordCommand}"/>
                    </Grid>

                    <ProgressBar Value="{Binding PasswordStrength}"
                                 Margin="0,10,0,0"/>

                    <TextBlock Text="Website" Style="{StaticResource FieldLabelText}"/>
                    <TextBox Text="{Binding Website}"/>

                    <TextBlock Text="Notes" Style="{StaticResource FieldLabelText}"/>
                    <TextBox Text="{Binding Notes}"
                             Height="96"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"/>

                    <TextBlock Text="Password change reminder" Style="{StaticResource FieldLabelText}"/>
                    <CheckBox Content="Remind me to change this saved password"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              IsChecked="{Binding CredentialPasswordReminderEnabled}"/>

                    <TextBlock Text="Reminder interval (months)" Style="{StaticResource FieldLabelText}"/>
                    <TextBox Text="{Binding CredentialPasswordReminderMonths}"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FFB4BD"
                               Margin="0,14,0,0"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,22,0,0">
                        <Button Content="Cancel"
                                Width="96"
                                Command="{Binding CancelCredentialFormCommand}"/>
                        <Button Content="Save"
                                Width="96"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCredentialCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
