<UserControl x:Class="SecureVault.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </UserControl.InputBindings>
    <Border Style="{StaticResource PanelCard}"
            Width="720">
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Password history"
                               Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="Changes recorded for the current account."
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <Button Content="Close"
                        Width="84"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Command="{Binding CloseCommand}"/>
            </Grid>

            <DataGrid ItemsSource="{Binding HistoryItems}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Height="320">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding ChangedDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                        Width="155"/>
                    <DataGridTextColumn Header="Action"
                                        Binding="{Binding Action}"
                                        Width="120"/>
                    <DataGridTextColumn Header="Credential"
                                        Binding="{Binding CredentialTitle}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Password"
                                        Binding="{Binding MaskedPassword}"
                                        Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Border>
</UserControl>
