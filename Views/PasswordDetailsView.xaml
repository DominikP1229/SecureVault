<UserControl x:Class="SecureVault.Views.PasswordDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <Grid Margin="10">
        <Border Background="#2D2D30"
                CornerRadius="10"
                Padding="20"
                Margin="10">
            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Username" Foreground="White" FontSize="18"/>
                <TextBox Text="{Binding Username}" IsReadOnly="True" Margin="0,5,0,10"/>

                <TextBlock Text="Category" Foreground="White" FontSize="18"/>
                <TextBox Text="{Binding Category}" IsReadOnly="True" Margin="0,5,0,10"/>

                <TextBlock Text="Password" Foreground="White" FontSize="18"/>
                <TextBox Text="{Binding EncryptedPassword}" IsReadOnly="True" Margin="0,5,0,10"/>

                <TextBlock Text="Website" Foreground="White" FontSize="18"/>
                <TextBox Text="{Binding Account}" IsReadOnly="True" Margin="0,5,0,10"/>

                <TextBlock Text="Notes" Foreground="White" FontSize="18"/>
                <TextBox Text="{Binding Description}" IsReadOnly="True" Height="80" AcceptsReturn="True" Margin="0,5,0,15"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Copy Password" Width="110" Margin="5" Click="CopyPassword_Click"/>
                    <Button Content="Copy URL" Width="90" Margin="5" Click="CopyUrl_Click"/>
                    <Button Content="Edit Password" Width="110" Margin="5" Click="EditPassword_Click"/>
                    <Button Content="Back" Width="80" Margin="5" Click="Back_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
