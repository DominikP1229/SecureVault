<UserControl x:Class="SecureVault.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             KeyDown="CategoriesView_KeyDown">
    <Border Style="{StaticResource PanelCard}"
            Width="460">
        <StackPanel>
            <TextBlock Text="Categories"
                       Style="{StaticResource PageTitleText}"/>
            <TextBlock Text="Create and manage categories used by password entries."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18"/>

            <ListBox x:Name="CategoryListBox"
                     Height="180"
                     ItemsSource="{Binding Categories}"
                     DisplayMemberPath="CategoryType"/>

            <TextBlock Text="New category" Style="{StaticResource FieldLabelText}"/>
            <TextBox x:Name="CategoryNameBox"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button Content="Close"
                        Width="86"
                        Click="Close_Click"/>
                <Button Content="Delete"
                        Width="92"
                        Style="{StaticResource DangerButton}"
                        Click="DeleteCategory_Click"/>
                <Button Content="Add"
                        Width="86"
                        Style="{StaticResource PrimaryButton}"
                        Click="AddCategory_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
