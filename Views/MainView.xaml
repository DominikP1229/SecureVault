<UserControl x:Class="SecureVault.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Vault"
                           Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="Manage saved credentials for the current account."
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <Button Content="History"
                        Width="98"
                        Command="{Binding OpenHistoryCommand}"/>
                <Button Content="Categories"
                        Width="112"
                        Command="{Binding OpenCategoriesCommand}"/>
                <Button Content="Settings"
                        Width="98"
                        Command="{Binding OpenSettingsCommand}"/>
                <Button Content="Logout"
                        Width="92"
                        Command="{Binding LogoutCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource PanelCard}"
                Padding="14"
                Margin="0,22,0,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="280"
                         Margin="0,0,12,0"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding FilterCategories}"
                          SelectedItem="{Binding SelectedFilterCategory}"
                          DisplayMemberPath="CategoryType"
                          Margin="0,0,12,0"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button Content="Add"
                            Width="86"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding OpenAddCommand}"/>
                    <Button Content="Import CSV"
                            Width="104"
                            Command="{Binding ImportCsvCommand}"/>
                    <Button Content="Export CSV"
                            Width="104"
                            Command="{Binding ExportCsvCommand}"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            Margin="0,12,0,0">
                    <TextBlock Text="Sort by"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding SortFields}"
                              SelectedItem="{Binding PrimarySortField}"
                              Width="150"
                              Margin="0,0,12,0"/>
                    <TextBlock Text="Then by"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding SortFields}"
                              SelectedItem="{Binding SecondarySortField}"
                              Width="150"
                              Margin="0,0,12,0"/>
                    <TextBlock Text="Direction"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding SortDirections}"
                              SelectedItem="{Binding SortDirection}"
                              Width="140"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource PanelCard}"
                Padding="0">
            <DataGrid AutoGenerateColumns="False"
                      ItemsSource="{Binding FilteredCredentials}"
                      SelectedItem="{Binding SelectedCredential}">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding OpenDetailsCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPasswordReminderExpired}" Value="True">
                                <Setter Property="Background" Value="#3A2429"/>
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,4,0"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPasswordReminderExpired}" Value="True"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#5A2B38"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Title"
                                        Binding="{Binding Title}"
                                        Width="1.2*"/>
                    <DataGridTextColumn Header="Username"
                                        Binding="{Binding Username}"
                                        Width="1.4*"/>
                    <DataGridTextColumn Header="Category"
                                        Binding="{Binding Category}"
                                        Width="0.8*"/>
                    <DataGridTextColumn Header="Website"
                                        Binding="{Binding Account}"
                                        Width="1.4*"/>
                    <DataGridTextColumn Header="Next reminder"
                                        Binding="{Binding NextPasswordReminderDate, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue=-}"
                                        Width="130"/>
                    <DataGridTemplateColumn Header="Actions" Width="210">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Button Content="Copy"
                                            MinHeight="30"
                                            Margin="2"
                                            Padding="10,4"
                                            Command="{Binding DataContext.CopyCredentialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Edit"
                                            MinHeight="30"
                                            Margin="2"
                                            Padding="10,4"
                                            Command="{Binding DataContext.EditCredentialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Delete"
                                            MinHeight="30"
                                            Margin="2"
                                            Padding="10,4"
                                            Style="{StaticResource DangerButton}"
                                            Command="{Binding DataContext.DeleteCredentialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border x:Name="SubViewContainer"
                Grid.RowSpan="3"
                Background="#B0000000"
                Visibility="Collapsed">
            <ContentControl x:Name="SubViewContent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
        </Border>

        <Border Grid.RowSpan="3"
                Background="#B0000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AccountPasswordReminderVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Style="{StaticResource PanelCard}"
                    Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Account password reminder"
                               Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="{Binding AccountPasswordReminderMessage}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="You can change the account password now or close this reminder."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,22"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="OK"
                                Width="86"
                                Command="{Binding DismissAccountPasswordReminderCommand}"/>
                        <Button Content="Change password"
                                Width="142"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenChangePasswordFromReminderCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
