<UserControl x:Class="SecureVault.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Vault"
                           Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="Manage saved credentials for the current account."
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <Button Content="History"
                        Width="98"
                        Click="OpenHistory"/>
                <Button Content="Categories"
                        Width="112"
                        Click="OpenCategories"/>
                <Button Content="Settings"
                        Width="98"
                        Click="OpenSettings"/>
                <Button Content="Logout"
                        Width="92"
                        Click="Logout_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource PanelCard}"
                Padding="14"
                Margin="0,22,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="280"
                         Margin="0,0,12,0"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding FilterCategories}"
                          SelectedItem="{Binding SelectedFilterCategory}"
                          DisplayMemberPath="CategoryType"
                          Margin="0,0,12,0"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button Content="Add"
                            Width="86"
                            Style="{StaticResource PrimaryButton}"
                            Click="Add_Click"/>
                    <Button Content="Copy"
                            Width="86"
                            Click="Copy_Click"/>
                    <Button Content="Delete"
                            Width="92"
                            Style="{StaticResource DangerButton}"
                            Click="Delete_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource PanelCard}"
                Padding="0">
            <DataGrid AutoGenerateColumns="False"
                      ItemsSource="{Binding FilteredCredentials}"
                      SelectedItem="{Binding SelectedCredential}"
                      MouseDoubleClick="PasswordGrid_MouseDoubleClick"
                      SelectionChanged="DataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Title"
                                        Binding="{Binding Title}"
                                        Width="1.2*"/>
                    <DataGridTextColumn Header="Username"
                                        Binding="{Binding Username}"
                                        Width="1.4*"/>
                    <DataGridTextColumn Header="Category"
                                        Binding="{Binding Category}"
                                        Width="0.8*"/>
                    <DataGridTextColumn Header="Website"
                                        Binding="{Binding Account}"
                                        Width="1.4*"/>
                    <DataGridTemplateColumn Header="Actions" Width="210">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Button Content="Copy"
                                            Padding="10,5"
                                            Click="Copy_Click"/>
                                    <Button Content="Edit"
                                            Padding="10,5"
                                            Click="Edit_Click"/>
                                    <Button Content="Delete"
                                            Padding="10,5"
                                            Style="{StaticResource DangerButton}"
                                            Click="Delete_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border x:Name="SubViewContainer"
                Grid.RowSpan="3"
                Background="#B0000000"
                Visibility="Collapsed">
            <ContentControl x:Name="SubViewContent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
