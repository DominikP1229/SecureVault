<UserControl x:Class="SecureVault.Controls.PasswordStrengthIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Width="260"
                Margin="0,10,0,0">
        <Grid Margin="0,0,0,6">
            <TextBlock Text="Password strength"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{Binding StrengthLabel, ElementName=Root}"
                       Foreground="{Binding StrengthBrush, ElementName=Root}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Right"/>
        </Grid>

        <Border Height="7"
                Background="#242A36"
                CornerRadius="4"
                ClipToBounds="True">
            <Grid>
                <Border Width="{Binding BarWidth, ElementName=Root}"
                        HorizontalAlignment="Left"
                        Background="{Binding StrengthBrush, ElementName=Root}"
                        CornerRadius="4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Strength, ElementName=Root}" Value="0">
                                    <Setter Property="Opacity" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
